<?xml version="1.0" encoding="UTF-8"?>
<!-- Lykuro Native LLM Platform - Private Gateway launchd daemon -->
<!-- 配置先: /Library/LaunchDaemons/ai.lykuro.private-gateway.plist -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.lykuro.private-gateway</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/lykuro/private-gateway/bin/private-gateway</string>
    <string>serve</string>
    <string>-config</string>
    <string>/etc/lykuro/gateway/gateway.yaml</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>LYKURO_INSTALL_TOKEN_FILE</key><string>/etc/lykuro/gateway/install-token.txt</string>
  </dict>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>StandardOutPath</key><string>/var/log/lykuro/private-gateway.log</string>
  <key>StandardErrorPath</key><string>/var/log/lykuro/private-gateway.log</string>
</dict>
</plist>
