# Lykuro Native LLM Platform - Private Gateway systemd unit
# 配置先: /etc/systemd/system/lykuro-private-gateway.service
[Unit]
Description=Lykuro Private LLM Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lykuro
Group=lykuro
ExecStart=/opt/lykuro/private-gateway/bin/private-gateway serve -config /etc/lykuro/gateway/gateway.yaml
Restart=on-failure
RestartSec=5
# install token は初回登録時のみ参照される(secret file で渡す。env へ直接書かない)
Environment=LYKURO_INSTALL_TOKEN_FILE=/etc/lykuro/gateway/install-token.txt
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lykuro/gateway
StateDirectory=lykuro-gateway

[Install]
WantedBy=multi-user.target
